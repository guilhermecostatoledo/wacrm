# Copy this file to .env before running Docker Compose.
# Never commit the resulting .env file.

# Image/build settings
WACRM_IMAGE=wacrm:local
WACRM_PORT=3000
APP_RELEASE=local

# Public values compiled into the Next.js browser bundle during docker build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en

# Runtime-only secrets. These are injected when the container starts and are
# deliberately not accepted as Docker build arguments.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=replace-with-64-hex-characters
META_APP_SECRET=your-meta-app-secret

# Optional runtime features
# ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=replace-with-a-long-random-string
# META_APP_ID=your-meta-app-id
# WHATSAPP_TEMPLATES_DRY_RUN=false
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
